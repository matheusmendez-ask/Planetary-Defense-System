# --- NASA NeoWs ---
# Obtenha uma chave gratuita em https://api.nasa.gov/ (ou use DEMO_KEY com rate limit baixo)
NASA_API_KEY=DEMO_KEY

# --- Supabase ---
# Use a service_role key (não a anon) — o ETL precisa de permissão de escrita
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LLM Provider (escolha um: anthropic | openai) ---
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Logging ---
LOG_LEVEL=INFO
